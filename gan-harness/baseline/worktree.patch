+/* ============================================ */
+/* Screenshot replica — topo hero layout        */
+/* Keeps all IDs/hooks; visual-only overrides. */
+/* Uses only existing tokens: --surface-* ladder for depth, */
+/* --border-control for control edges, --text-*, --space-*, */
+/* --radius-*, --shadow-*, --font-ui/content, motion tokens. */
+/* ============================================ */
+
+/* ── 1. Topographic background on chat canvas ── */
+.chat-container {
+  background-color: var(--bg);
+  /* No `isolation: isolate` here. It would create a stacking context and trap
+     `position: fixed` descendants — `#export-dropdown-menu` (fixed, z-index 300)
+     lives inside .chat-top-bar and would be contained by, and clipped under, the
+     chat column. The pseudo-elements below are given explicit z-index 0 and the
+     real content z-index 1+, which orders them without a new context. */
+}
+.chat-container::before {
+  content: "";
+  position: absolute;
+  inset: 0;
+  z-index: 0;
+  pointer-events: none;
+  background-image: url("/static/icons/topo-dark.png");
+  background-size: cover;
+  background-position: center;
+  background-repeat: no-repeat;
+  opacity: 0.9;
+}
+.chat-container::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  z-index: 0;
+  pointer-events: none;
+  background: rgba(0, 0, 0, 0.3);
+}
+/* Lift only the elements that must sit ABOVE the background layer. A blanket
+   `.chat-container > *` rule would also capture `#custom-preset-modal`, which is
+   a direct child and is `position: fixed` at z-index 250 — forcing it to
+   `position: relative` collapses it into the chat column's normal flow. */
+.chat-container > #chat-history,
+.chat-container > .attach-strip,
+.chat-container > .chat-input-bar,
+.chat-container > #welcome-screen {
+  position: relative;
+  z-index: 1;
+}
+.chat-container > .chat-top-bar {
+  position: relative;
+  z-index: 2;
+}
+
+/* ── 2. Top-center session pill ── */
+.chat-top-bar .chat-meta-overlay {
+  position: static;
+  left: auto;
+  right: auto;
+  top: auto;
+  transform: none;
+  margin: 0 auto;
+  width: max-content;
+  max-width: min(92vw, 420px);
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-1);
+  background: var(--bg);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-full);
+  box-shadow: var(--shadow-sm);
+  padding: var(--space-1) var(--space-2);
+  font-family: var(--font-ui);
+  font-size: var(--text-sm);
+  line-height: 1.3;
+  color: var(--fg);
+  white-space: nowrap;
+  overflow: hidden;
+}
+.chat-top-bar .chat-meta-overlay #current-meta {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  color: var(--fg);
+}
+.chat-top-bar .chat-meta-overlay #current-meta-count,
+.chat-top-bar .chat-meta-overlay #session-cost-display {
+  color: var(--fg-muted);
+  font-size: var(--text-sm);
+}
+.chat-top-bar .export-dropdown-wrap {
+  margin: 0;
+}
+.chat-top-bar .export-dl-btn {
+  padding: var(--space-1);
+}
+
+/* ── 3. Welcome hero: large mark + spaced tagline ── */
+#welcome-screen .welcome-logo {
+  width: min(520px, 72vw);
+  max-width: 72vw;
+}
+.welcome-tagline {
+  font-family: var(--font-ui);
+  font-size: var(--text-base);
+  font-weight: 500;
+  letter-spacing: 0.35em;
+  text-indent: 0.35em;
+  line-height: 1.6;
+  text-align: center;
+  color: var(--fg-muted);
+  margin: var(--space-2) 0 var(--space-1);
+  white-space: nowrap;
+  user-select: none;
+  pointer-events: none;
+}
+#welcome-screen .welcome-sub {
+  margin: 0;
+  text-align: center;
+  line-height: 1.5;
+  max-width: 320px;
+}
+/* The ref hero is logo + tagline only. The tip and version lines are prose the
+   ref omits, so they collapse. `.welcome-sub` and `.incognito-btn` are KEPT:
+   nobody-mode's visible toggle lives in .incognito-btn, and hiding it left the
+   feature reachable only by slash command and a keyboard shortcut. `.welcome-sub`
+   also gets style.display='' restored by app.js after research mode, which a
+   display:none here would silently swallow. */
+#welcome-screen .welcome-tip,
+#welcome-screen .welcome-version {
+  display: none;
+}
+/* Idle "ready" hint lines ("New chat ready." / "Yours for the voyage." plus the
+   rotating tip) sit right above the composer and read as stray text behind it,
+   so they collapse — hero stays logo + tagline only. Scoped to .is-ready-hint
+   (toggled by _syncWelcomeModelHint / models.js) so setup, research and Nobody
+   texts keep showing. Visibility-based, not display:none: app.js restores
+   style.display='' after research mode, which display:none would swallow. */
+.chat-container.welcome-active #welcome-screen .welcome-sub.is-ready-hint,
+.chat-container.welcome-active #welcome-screen .welcome-tip.is-ready-hint {
+  visibility: hidden;
+  opacity: 0;
+  max-height: 0;
+  margin: 0;
+  pointer-events: none;
+}
+/* Keep hero clear of the raised composer on welcome — but only where there is
+   room. The max-height guards further down (28% / 22% / hidden) exist to stop
+   the hero colliding with the composer on short viewports, and this selector's
+   (1,2,0) specificity would beat all of them. */
+@media (min-height: 751px) {
+  .chat-container.welcome-active #welcome-screen {
+    top: 36%;
+  }
+}
+
+/* ── 4. Sidebar: header mark, section labels, rows ── */
+.sidebar {
+  width: 280px;
+  background: var(--bg);
+  border-right: 1px solid var(--border-subtle);
+}
+.sidebar.right-side {
+  border-right: none;
+  border-left: 1px solid var(--border-subtle);
+}
+.sidebar-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--space-2);
+  padding: var(--space-3) var(--space-3) var(--space-2);
+  min-height: 48px;
+  background: var(--bg);
+}
+.sidebar-logo {
+  display: block;
+  height: 28px;
+  width: auto;
+  max-width: 180px;
+  object-fit: contain;
+  user-select: none;
+}
+.sidebar-header .sidebar-hamburger.sidebar-collapse-btn {
+  /* No display declaration: visibility is owned by #sidebar-toggle-btn's
+     parked rule below (and the base .sidebar-hamburger none before it). */
+  width: 30px;
+  height: 30px;
+  align-items: center;
+  justify-content: center;
+  background: none;
+  border: none;
+  border-radius: var(--radius-sm);
+  color: var(--fg-muted);
+  cursor: pointer;
+  opacity: 0.7;
+  transition: opacity var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
+}
+.sidebar-header .sidebar-hamburger.sidebar-collapse-btn:hover {
+  opacity: 1;
+  color: var(--fg);
+  background: var(--surface-3);
+}
+.sidebar-inner {
+  font-family: var(--font-ui);
+}
+#sidebar-new-chat-btn,
+#sidebar-search-btn {
+  font-family: var(--font-ui);
+  font-size: var(--text-sm);
+  margin-bottom: var(--space-1);
+  padding: var(--space-1) var(--space-2);
+  min-height: 0;
+  background: var(--bg);
+  border: 1px solid var(--border-subtle);
+  border-radius: var(--radius-sm);
+  display: flex;
+  align-items: center;
+  gap: var(--space-2);
+  line-height: 1.3;
+}
+#sidebar-new-chat-btn svg,
+#sidebar-new-chat-btn .grow,
+#sidebar-search-btn svg,
+#sidebar-search-btn .grow {
+  position: static;
+  left: auto;
+}
+#sidebar-new-chat-btn .grow,
+#sidebar-search-btn .grow {
+  flex: 1;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  line-height: 1.4;
+}
+/* Same icon box on both rows (markup uses 15px vs 13px) so the glyphs and
+   labels line up instead of staggering. */
+#sidebar-new-chat-btn svg,
+#sidebar-search-btn svg {
+  width: 14px;
+  height: 14px;
+  flex-shrink: 0;
+}
+@media (max-width: 768px) {
+  /* Touch rules elsewhere force these rows to 48px tall full-width boxes;
+     44px keeps an accessible target without the chunky look. Later in the
+     file so it wins over the earlier !important rule. */
+  #sidebar-new-chat-btn,
+  #sidebar-search-btn {
+    padding: var(--space-2) var(--space-3) !important;
+    min-height: 44px !important;
+  }
+}
+.sidebar .section-title,
+.sidebar .section-title-label {
+  font-family: var(--font-ui);
+  font-size: var(--text-xs);
+  letter-spacing: var(--tracking-wide);
+  text-transform: uppercase;
+  color: var(--fg-subtle);
+  line-height: 1.3;
+}
+.sidebar .list-item {
+  font-family: var(--font-ui);
+  font-size: var(--text-base);
+  border-radius: var(--radius-sm);
+  display: flex;
+  align-items: center;
+  gap: var(--space-2);
+  padding: var(--space-1) var(--space-2);
+  line-height: 1.3;
+}
+.sidebar .list-item svg,
+.sidebar .section-title svg {
+  flex-shrink: 0;
+}
+/* Sidebar icons match the tool rows: quiet grey, not the red danger fallback.
+   The base rule points .section-icon / .sidebar-action-icon at
+   var(--accent-ink, var(--red)), which resolves to danger red. */
+.section-icon,
+.sidebar-action-icon {
+  left: auto;
+  stroke: currentColor;
+  color: var(--fg-muted);
+}
+#sidebar-new-chat-btn .sidebar-action-icon,
+#sidebar-search-btn .sidebar-action-icon {
+  color: var(--fg-muted);
+  opacity: 0.5;
+}
+#tools-section .list-item {
+  color: var(--fg);
+}
+#tools-section .list-item:hover,
+#sessions-section .list-item:hover {
+  background: var(--surface-3);
+}
+
+/* ── 5. Composer: black card with no border line, pill picker, boxed tools ──
+ * The edge reads as a luminance step (surface-1 over the canvas), never as
+ * a grey hairline. */
+.chat-container .chat-input-bar {
+  background: var(--bg);
+  border: 1px solid var(--border-subtle);
+  border-radius: var(--radius-lg);
+  box-shadow: none;
+  padding: var(--space-2) var(--space-4);
+  max-width: 800px;
+}
+/* Screenshot shows one uniform field, not an inset well. */
+.chat-input-top {
+  background: transparent;
+  border-radius: 0;
+  padding: 0;
+}
+.chat-input-bar textarea#message {
+  font-family: var(--font-content);
+  font-size: var(--text-md);
+  line-height: 1.5;
+  text-align: left;
+  min-height: 28px;
+  padding: var(--space-1) 0;
+  padding-right: 168px;
+}
+/* The global form reset paints a surface wash + focus ring on every
+   textarea — on this borderless field that reads as a grey box. Keep the
+   composer field flat in all states; the caret is the indicator. */
+.chat-input-bar textarea#message:hover,
+.chat-input-bar textarea#message:focus {
+  background: transparent;
+  border-color: transparent;
+  box-shadow: none;
+}
+/* Model pill, top-right of the field. */
+.chat-input-top > .model-picker-wrap {
+  top: 0;
+  right: 0;
+}
+.model-picker-btn {
+  height: 28px;
+  max-width: 220px;
+  padding: 0 var(--space-2);
+  font-size: var(--text-sm);
+  background: var(--surface-1);
+  border: 1px solid var(--border-control);
+  border-radius: var(--radius-full);
+  color: var(--fg-muted);
+  box-shadow: var(--shadow-sm);
+}
+.model-picker-btn #model-picker-label {
+  max-width: 150px;
+}
+/* Bottom row: boxed tool keys left, mode + send right. */
+.chat-input-bottom {
+  margin-top: var(--space-2);
+}
+.chat-input-left > .input-icon-btn,
+.chat-input-left > .overflow-wrapper > .input-icon-btn {
+  border: 1px solid var(--border-control);
+  border-radius: var(--radius-sm);
+  background: var(--surface-1);
+  opacity: 0.85;
+  box-shadow: var(--shadow-sm);
+}
+.mode-toggle {
+  background: var(--surface-1);
+  /* Same reason as the composer edge above — a segmented control's boundary is
+     the affordance. */
+  border: 1px solid var(--border-control);
+  border-radius: var(--radius-full);
+  padding: var(--space-1);
+}
+/* Desktop only. The mobile rule further up sets 48×48 for touch targets; an
+   !important 40px here would beat it and drop send under the 44×44 floor. */
+@media (min-width: 769px) {
+  .send-btn.newchat-mode,
+  .send-btn[data-mode="send"] {
+    width: 40px !important;
+    min-width: 40px;
+    height: 40px !important;
+    border-radius: var(--radius-md);
+  }
+}
+/* Ref hero shows a white send key with a dark glyph, not the accent fill. */
+.chat-input-bar .send-btn {
+  background: var(--fg-strong);
+  color: var(--bg);
+}
+.chat-input-bar .send-btn:hover {
+  background: var(--fg);
+  color: var(--bg);
+}
+
+/* ── 6. Narrow + motion gates ── */
+@media (max-width: 768px) {
+  .sidebar {
+    width: 240px;
+  }
+  #welcome-screen .welcome-logo {
+    width: min(360px, 80vw);
+  }
+  .welcome-tagline {
+    font-size: var(--text-sm);
+    letter-spacing: 0.22em;
+    text-indent: 0.22em;
+    white-space: normal;
+    text-align: center;
+    line-height: 2;
+  }
+  .chat-container.welcome-active .chat-input-bar {
+    margin-bottom: var(--space-2);
+  }
+  .chat-top-bar .chat-meta-overlay {
+    max-width: 92vw;
+  }
+}
+/* Desktop only — the mobile .chat-top-bar rule above sets its own
+   margin-top:-31px / padding-top:31px pair to tuck the bar under the fixed
+   header, and this padding shorthand would clobber the compensation. */
+@media (min-width: 769px) {
+  .chat-top-bar {
+    padding: var(--space-3) 0 var(--space-2);
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  /* Blanket kill: every entrance/pulse/shimmer animation in the app resolves
+     here, so no keyframe can move for reduced-motion users. End states are
+     unaffected (durations zero out, final frames persist). */
+  *, *::before, *::after {
+    animation-duration: 0ms !important;
+    transition-duration: 0ms !important;
+  }
+  .chat-container .chat-input-bar,
+  .sidebar-header .sidebar-hamburger.sidebar-collapse-btn,
+  .model-picker-btn,
+  .chat-input-left > .input-icon-btn {
+    animation-duration: 0ms !important;
+    transition-duration: 0ms !important;
+  }
+}
+
+/* ── 7. Settings modal follows the black theme ── */
+#settings-modal .settings-modal-content {
+  background: var(--bg);
+  border: 1px solid var(--border-subtle);
+}
+#settings-modal .settings-sidebar {
+  background: transparent;
+  border-right: 1px solid var(--border-subtle);
+}
+#settings-modal .admin-card {
+  background: var(--bg);
+  border: 1px solid var(--border-subtle);
+}
+#settings-modal .settings-nav-item.active {
+  background: color-mix(in srgb, var(--fg) 8%, transparent);
+  color: var(--fg);
+}
+
+/* ── 8. Tool popups follow the black theme ──
+ * Modal windows, cards and popup menus drop their grey fills for var(--bg)
+ * with a --border-subtle micro edge. Inputs/buttons keep their --surface-*
+ * wells — wells are affordances, not surfaces. ID-scoped exceptions above
+ * this (e.g. the integrations-form tint) still win on specificity. */
+.modal-content,
+#cookbook-modal .modal-content,
+.memory-modal-content,
+.tasks-modal-content,
+.preset-modal-content,
+.doclib-modal-content,
+.gallery-modal-content,
+.cal-modal-content {
+  background: var(--bg);
+  border: 1px solid var(--border-subtle);
+}
+.admin-card {
+  background: var(--bg);
+  border: 1px solid var(--border-subtle);
+}
+.dropdown,
+.model-picker-menu,
+.overflow-menu,
+.export-dropdown-menu {
+  background: var(--bg);
+  border: 1px solid var(--border-subtle);
+}
+
+/* ── 9. Response bubbles follow the black theme ──
+ * AI bubble drops its grey slab for var(--bg) with a micro edge; hover lifts
+ * the edge instead of flashing a grey fill. The user bubble's old fill mixed
+ * from undefined --accent-ink, which computed to transparent (bare text on
+ * the topo background) — it now gets an explicit --surface-1 fill plus edge.
+ * Footer meta gets a hairline + breathing room so metrics and icon buttons
+ * stop crowding the prose. */
+.msg-ai {
+  background: var(--bg);
+  border: 1px solid var(--border-subtle);
+}
+.msg-ai:hover {
+  background: var(--bg);
+  border-color: var(--border);
+}
+.msg-user {
+  background: var(--surface-1);
+  border: 1px solid var(--border-subtle);
+}
+.msg-footer {
+  border-top: 1px solid var(--border-subtle);
+  padding-top: var(--space-2);
+}
+.msg-footer .msg-actions {
+  gap: var(--space-1);
+}
+.footer-copy-btn,
+.regen-btn,
+.fork-btn {
+  padding: 4px 8px;
+  border-radius: var(--radius-sm);
+}
+.footer-copy-btn:hover,
+.regen-btn:hover,
+.fork-btn:hover {
+  color: var(--fg);
+  background: color-mix(in srgb, var(--fg) 8%, transparent);
+}
+
+/* ── 10. Spinners follow the monochrome theme ──
+ * The old spinners read --red / hardcoded ice-blue. All spinners (text,
+ * whirlpool, sinewave) now render in --fg-muted grey. */
+.ai-spinner {
+  color: var(--fg-muted);
+}
+
+/* ── 11. One sidebar toggle: the lines (hamburger) icon ──
+ * The fixed hamburger and the in-sidebar chevron toggle painted as one
+ * mashed icon. The hamburger stays as the single toggle in every state;
+ * the in-sidebar chevron is parked (it only proxied a click to the
+ * hamburger anyway). The header box itself stays as top clearance so the
+ * fixed button never covers sidebar content. */
+#sidebar-toggle-btn {
+  display: none !important;
+}
